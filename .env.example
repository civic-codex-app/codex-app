# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin. NO trailing slash — it is concatenated (e.g. `${BASE_URL}/quiz`),
# so a trailing "/" produces "//quiz" and breaks OG/share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- News ingestion for the homepage "Today in Politics" strip ---
# Optional. Publisher RSS is the primary source and needs no key; GNews is merged
# in for images/breadth when present. NOTE: the GNews free tier is 12 hours
# delayed and 429s on bursts, so it must not be the only source.
# This variable being undocumented is why it went unset and the homepage served
# 125-day-old headlines. See lib/utils/daily-topics.ts.
GNEWS_API_KEY=

# Shared secret for /api/cron/* routes. Set this in the deploy environment or the
# cron endpoints are publicly callable.
CRON_SECRET=

# --- Data refresh scripts (CLI only, not needed at runtime) ---
# scripts/import-fec-finance.mjs        — https://api.data.gov/signup/  (60/hr)
FEC_API_KEY=
# scripts/rebuild-bills-from-congress.mjs, scripts/fetch-voting-records.mjs
#                                       — https://api.congress.gov/sign-up/ (20k/hr)
CONGRESS_API_KEY=

# --- Cloudflare R2 image storage ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Must match the real bucket. Production uses `codex`; note lib/r2.ts falls back
# to `poli-images` and scripts/migrate-images-to-r2.mjs to `codex`, so always set
# this explicitly rather than relying on a default.
R2_BUCKET_NAME=codex
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
